{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "position": "left",
        "width": 20,
        "height": 10,
    },
        "display": {
        "separator": "  ",
        "color": { "keys": "green", "output": "blue", "title": "green" },
        "constants": ["\u001b[32m", "\u001b[32m"]
    },
    "modules": [
        {
            "type": "custom",
            "key": "  ╭─Hodow-Feli─╮"
        },
        {
            "type": "command",
            "key": "  │ {$2}{$1}  usuario │",
            "text": "echo $USER"
        },
        {
            "type": "kernel",
            "key": "  │ {$2}{$1}  kernel  │"
        },
        {
            "type": "os",
            "key": "  │ {$2}{$1}  os      │"
        },
        {
            "type": "wm",
            "key": "  │ 󱂬  wm      │"
        },
        {
            "type": "terminal",
            "key": "  │   terminal│",
            "folder": "/"
        },
        {
            "type": "memory",
            "key": "  │ {$2}{$1}  memoria │"
        },
        {
            "type": "uptime",
            "key": "  │ 󰋊  Uptime  │"
        },
        {
            "type": "datetime",
            "key": "  │ 󰸗  fecha   │"
        },
        {
            "type": "packages",
            "key": "  │   Paquetes│"
        },
        {
            "type": "custom",
            "key": "  ╰────────────╯"
        },
        {
            "type": "colors",
            "key": "  ",
            "symbol": "circle"
        }
    ]
}
